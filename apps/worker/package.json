{
  "name": "@tetraboard/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "preview:production": "wrangler dev --env production --local --ip 127.0.0.1 --port 8788 --local-upstream 127.0.0.1:8788 --upstream-protocol http --var APP_ORIGIN:http://127.0.0.1:8788 --persist-to .wrangler/production-preview",
    "db:migrate:preview": "wrangler d1 migrations apply APP_DB --env production --local --persist-to .wrangler/production-preview",
    "db:migrate:production": "wrangler d1 migrations apply APP_DB --env production --remote",
    "dev": "bun run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply tetraboard-lobby-local --local",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=true CLOUDFLARE_INCLUDE_PROCESS_ENV=false wrangler types --env-file .dev.vars.example",
    "typecheck": "bun run cf-typegen && tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "oxlint .",
    "test": "vitest run --max-workers=1 --no-isolate"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@types/node": "^22",
    "typescript": "^5.5.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "@tetraboard/four-reversi": "workspace:*",
    "@tetraboard/four-shogi": "workspace:*",
    "@tetraboard/protocol": "workspace:*",
    "better-auth": "1.7.5",
    "hono": "^4.13.10",
    "zod": "^4.0.0",
    "@tetraboard/reversi": "workspace:*",
    "@tetraboard/shogi": "workspace:*",
    "@tetraboard/four-gomoku": "workspace:*",
    "@tetraboard/gomoku": "workspace:*"
  }
}
