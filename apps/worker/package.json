{
  "name": "@tetraboard/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --env production --dry-run",
    "preview:production": "wrangler dev --env production --local --ip 127.0.0.1 --port 8788 --local-upstream 127.0.0.1:8788 --upstream-protocol http --var APP_ORIGIN:http://127.0.0.1:8788 --persist-to .wrangler/production-preview",
    "db:migrate:preview": "wrangler d1 migrations apply APP_DB --env production --local --persist-to .wrangler/production-preview",
    "db:migrate:production": "wrangler d1 migrations apply APP_DB --env production --remote",
    "dev": "bun run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply tetraboard-lobby-local --local",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=true CLOUDFLARE_INCLUDE_PROCESS_ENV=false wrangler types --env-file .dev.vars.example",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun run cf-typegen && bun check --no-script --all -b tsconfig.check.json",
    "typecheck:tsc": "bun run cf-typegen && tsc --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "oxlint .",
    "test": "vitest run --max-workers=1 --no-isolate",
    "deploy:development": "bun ../../scripts/verifyDevelopmentConfig.ts && wrangler deploy --env development",
    "deploy:dry-run:development": "wrangler deploy --env development --dry-run",
    "db:migrate:development": "bun ../../scripts/verifyDevelopmentConfig.ts && wrangler d1 migrations apply APP_DB --env development --remote",
    "db:generate": "bun scripts/generateMigration.ts",
    "test:db": "bun test ./test-bun"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@types/node": "^22",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.5.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@tetraboard/context-account": "workspace:*",
    "@tetraboard/context-community": "workspace:*",
    "@tetraboard/context-matchmaking": "workspace:*",
    "@tetraboard/context-rating": "workspace:*",
    "@tetraboard/context-record": "workspace:*",
    "@tetraboard/context-room": "workspace:*",
    "@tetraboard/context-tournament": "workspace:*",
    "@tetraboard/four-gomoku": "workspace:*",
    "@tetraboard/four-reversi": "workspace:*",
    "@tetraboard/four-shogi": "workspace:*",
    "@tetraboard/game-contract": "workspace:*",
    "@tetraboard/gomoku": "workspace:*",
    "@tetraboard/protocol": "workspace:*",
    "@tetraboard/reversi": "workspace:*",
    "@tetraboard/shogi": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.10",
    "zod": "^4.0.0"
  }
}
