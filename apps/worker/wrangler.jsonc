{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tetraboard-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "USAGE_EVENTS_DATASET": "tetraboard_usage_events_local",
    "APP_ORIGIN": "http://localhost:5173",
    "MATCHMAKING_ENABLED": "false",
    "SHOGI_MATCHMAKING_ENABLED": "false"
  },
  "analytics_engine_datasets": [
    { "binding": "USAGE_EVENTS", "dataset": "tetraboard_usage_events_local" }
  ],
  "analytics": { "binding": "ANALYTICS_SQL" },
  "r2_buckets": [
    {
      "binding": "OBJECT_STORAGE",
      "bucket_name": "tetraboard-2026-objects-local"
    }
  ],
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "TOURNAMENT_COORDINATOR",
        "class_name": "TournamentCoordinator"
      },
      { "name": "MATCHMAKING_COORDINATOR", "class_name": "MatchmakingCoordinator" },
      { "name": "CPU_CAPACITY", "class_name": "CpuCapacity" }
    ]
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "tetraboard-lobby-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "TournamentCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MatchmakingCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "CpuCapacity": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },
  "env": {
    "production": {
      "name": "tetraboard-2026",
      "analytics": { "binding": "ANALYTICS_SQL" },
      "analytics_engine_datasets": [
        { "binding": "USAGE_EVENTS", "dataset": "tetraboard_usage_events" }
      ],
      "vars": {
        "USAGE_EVENTS_DATASET": "tetraboard_usage_events",
        "APP_ORIGIN": "https://tetraboard.net",
        "MATCHMAKING_ENABLED": "true",
        "SHOGI_MATCHMAKING_ENABLED": "true",
        "AI_RATED_ONLY": "true",
        "REVERSI_MATCHMAKING_ENABLED": "true",
        "FOUR_SHOGI_MATCHMAKING_ENABLED": "true",
        "AI_SHOGI_ENABLED": "true",
        "AI_REVERSI_ENABLED": "true",
        "FOUR_SHOGI_DIAGNOSTICS": "true",
        "AI_WARMUP_ENABLED": "true",
        "AI_SERVICE_TIMEOUT_MS": "5000",
        "AI_FOUR_REVERSI_TIMEOUT_MS": "10000"
      },
      "services": [{ "binding": "AI_GATEWAY", "service": "tetraboard-ai-prod" }],
      "routes": [
        {
          "pattern": "tetraboard.net",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECT_STORAGE",
          "bucket_name": "tetraboard-2026-objects-prod",
          "remote": false
        }
      ],
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/assets",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "html_handling": "none",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          },
          {
            "name": "TOURNAMENT_COORDINATOR",
            "class_name": "TournamentCoordinator"
          },
          { "name": "MATCHMAKING_COORDINATOR", "class_name": "MatchmakingCoordinator" },
          { "name": "CPU_CAPACITY", "class_name": "CpuCapacity" }
        ]
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "tetraboard-2026-prod-db",
          "database_id": "196b58e7-0df3-40db-b3ec-d196c88241bf",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "exports": {
        "GameRoom": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "TournamentCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "MatchmakingCoordinator": { "type": "durable-object", "storage": "sqlite" },
        "CpuCapacity": { "type": "durable-object", "storage": "sqlite" }
      },
      "observability": {
        "enabled": true
      },
      "triggers": {
        "crons": ["0 * * * *", "*/5 * * * *"]
      }
    },
    "development": {
      "name": "tetraboard-dev",
      "analytics": { "binding": "ANALYTICS_SQL" },
      "analytics_engine_datasets": [
        { "binding": "USAGE_EVENTS", "dataset": "tetraboard_usage_events_dev" }
      ],
      "vars": {
        "USAGE_EVENTS_DATASET": "tetraboard_usage_events_dev",
        "APP_ORIGIN": "https://tetraboard-dev.chaossi-lab.workers.dev",
        "MATCHMAKING_ENABLED": "true",
        "SHOGI_MATCHMAKING_ENABLED": "true",
        "AI_SHOGI_ENABLED": "true",
        "AI_REVERSI_ENABLED": "true",
        "REVERSI_MATCHMAKING_ENABLED": "true",
        "FOUR_SHOGI_MATCHMAKING_ENABLED": "true",
        "FOUR_SHOGI_DIAGNOSTICS": "true",
        "AI_WARMUP_ENABLED": "true",
        "AI_SERVICE_TIMEOUT_MS": "5000",
        "AI_FOUR_REVERSI_TIMEOUT_MS": "10000",
        "AI_RATED_ONLY": "false"
      },
      "services": [{ "binding": "AI_GATEWAY", "service": "tetraboard-ai-dev" }],
      "routes": [],
      "r2_buckets": [
        {
          "binding": "OBJECT_STORAGE",
          "bucket_name": "tetraboard-dev-objects",
          "remote": false
        }
      ],
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/assets",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "html_handling": "none",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          },
          {
            "name": "TOURNAMENT_COORDINATOR",
            "class_name": "TournamentCoordinator"
          },
          { "name": "MATCHMAKING_COORDINATOR", "class_name": "MatchmakingCoordinator" },
          { "name": "CPU_CAPACITY", "class_name": "CpuCapacity" }
        ]
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "tetraboard-dev-db",
          "database_id": "7b32f756-ba1c-4247-a544-e91cfe64b9d3",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "exports": {
        "GameRoom": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "TournamentCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "MatchmakingCoordinator": { "type": "durable-object", "storage": "sqlite" },
        "CpuCapacity": { "type": "durable-object", "storage": "sqlite" }
      },
      "observability": {
        "enabled": true
      },
      "triggers": {
        "crons": ["0 * * * *", "*/5 * * * *"]
      }
    }
  }
}
