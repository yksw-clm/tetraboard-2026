{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tetraboard-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true
  }
}
