{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tetraboard-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "http://localhost:5173"
  },
  "r2_buckets": [
    {
      "binding": "OBJECT_STORAGE",
      "bucket_name": "tetraboard-2026-objects-local"
    }
  ],
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "tetraboard-lobby-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "env": {
    "production": {
      "name": "tetraboard-2026",
      "vars": {
        "APP_ORIGIN": "https://tetraboard.net"
      },
      "routes": [
        {
          "pattern": "tetraboard.net",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBJECT_STORAGE",
          "bucket_name": "tetraboard-2026-objects-prod",
          "remote": false
        }
      ],
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/assets",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "html_handling": "none",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "tetraboard-2026-prod-db",
          "database_id": "196b58e7-0df3-40db-b3ec-d196c88241bf",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "exports": {
        "GameRoom": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "observability": {
        "enabled": true
      },
      "triggers": {
        "crons": ["0 * * * *"]
      }
    },
    "development": {
      "name": "tetraboard-dev",
      "vars": {
        "APP_ORIGIN": "https://tetraboard-dev.chaossi-lab.workers.dev"
      },
      "routes": [],
      "r2_buckets": [
        {
          "binding": "OBJECT_STORAGE",
          "bucket_name": "tetraboard-dev-objects",
          "remote": false
        }
      ],
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist/assets",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "html_handling": "none",
        "run_worker_first": true
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOM",
            "class_name": "GameRoom"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "tetraboard-dev-db",
          "database_id": "7b32f756-ba1c-4247-a544-e91cfe64b9d3",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "exports": {
        "GameRoom": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "observability": {
        "enabled": true
      },
      "triggers": {
        "crons": ["0 * * * *"]
      }
    }
  }
}
