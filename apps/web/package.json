{
  "name": "@tetraboard/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck:build && bun run build:assets",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all -b tsconfig.check.json",
    "typecheck:build": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all -b tsconfig.json && bun check --no-script --all -p tsconfig.build.json",
    "typecheck:tsc": "tsc -b && tsc -p tsconfig.test.json && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "bun run test:unit && bun run test:dom",
    "test:unit": "bun test ./test",
    "test:dom": "bun test --preload ../../test-support/dom.ts ./test-dom",
    "build:assets": "vite build && bun build/generatePublicLobbies.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@jsquash/webp": "1.5.0",
    "@tetraboard/four-gomoku": "workspace:*",
    "@tetraboard/four-reversi": "workspace:*",
    "@tetraboard/four-shogi": "workspace:*",
    "@tetraboard/gomoku": "workspace:*",
    "@tetraboard/protocol": "workspace:*",
    "@tetraboard/reversi": "workspace:*",
    "@tetraboard/shogi": "workspace:*",
    "motion": "^14.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "@tetraboard/shogi-ui": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
