[Unit]
Description=TetraBoard four-player shogi AI trial
After=network.target

[Service]
Type=simple
User=tetraboard-ai
Group=tetraboard-ai
WorkingDirectory=/opt/tetraboard
EnvironmentFile=/etc/tetraboard-ai.env
ExecStart=/usr/local/bin/bun --no-env-file apps/four-shogi-ai/src/main.ts
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=5
MemoryMax=1G
CPUQuota=200%
TasksMax=64
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
