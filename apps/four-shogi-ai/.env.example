# 実値はGit外のEnvironmentFileへ保存し、権限を600にします。
AI_CODE_VERSION=replace-with-40-character-source-commit
AI_SHARED_SECRET=replace-with-at-least-32-random-characters
AI_MODEL_DIRECTORY=/var/lib/tetraboard-ai/models/current
AI_PYTHON=/usr/local/bin/python
AI_HOST=127.0.0.1
AI_PORT=8790
# 下記は試用値です。実VPSの収容数・正式な保持期間を確定する設定ではありません。
AI_WORKERS=2
AI_CPU_RESERVED=1
AI_MAX_QUEUE_CPU=16
AI_MAX_QUEUE_ANALYSIS=4
AI_MAX_PENDING_PER_PRINCIPAL=2
AI_MAX_JOBS=128
AI_MAX_PRINCIPALS=128
AI_MAX_REQUEST_BYTES=524288
AI_MAX_RESULT_BYTES=1048576
AI_MAX_EVENTS=2048
AI_MAX_CPU_MS=500
AI_MAX_ANALYSIS_MS=30000
AI_MAX_CPU_WORK=32768
AI_MAX_ANALYSIS_WORK=1000000
AI_MAX_QUEUE_MS=10000
AI_RESULT_TTL_MS=120000
AI_QUOTA_WINDOW_MS=60000
AI_CPU_REQUESTS=120
AI_ANALYSIS_REQUESTS=6
AI_CPU_BUDGET_MS=60000
AI_ANALYSIS_BUDGET_MS=90000
AI_MAX_RSS_BYTES=939524096
AI_CANCEL_GRACE_MS=250
AI_STARTUP_TIMEOUT_MS=15000
