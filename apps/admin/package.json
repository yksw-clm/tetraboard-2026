{
  "name": "@tetraboard/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "bun run typecheck && bun run build:assets",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:dom",
    "preview": "vite preview",
    "test:unit": "bun test ./test",
    "test:dom": "bun test --preload ../../test-support/dom.ts ./test-dom",
    "build:assets": "vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@tetraboard/protocol": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
