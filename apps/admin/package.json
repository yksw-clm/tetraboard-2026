{
  "name": "@tetraboard/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "bun run typecheck && bun run build:assets",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:dom",
    "preview": "vite preview",
    "test:unit": "bun test ./test",
    "test:dom": "bun test --preload ../../test-support/dom.ts ./test-dom",
    "build:assets": "vite build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tetraboard/protocol": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
