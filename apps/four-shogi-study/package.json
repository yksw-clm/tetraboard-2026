{
  "name": "@tetraboard/four-shogi-study",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "bun --no-env-file src/server/main.ts",
    "build": "bun run typecheck && vite build",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:dom",
    "test:unit": "bun test ./test",
    "test:dom": "bun test --preload ../../test-support/dom.ts ./test-dom"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tetraboard/four-shogi": "workspace:*",
    "@tetraboard/protocol": "workspace:*",
    "@tetraboard/shogi-ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.8",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "tw-animate-css": "^1.4.0"
  }
}
