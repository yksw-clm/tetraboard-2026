{
  "name": "@tetraboard/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./board": "./src/board.ts",
    "./board-pages": "./src/boardPages.ts",
    "./board-presentation": "./src/boardPresentation.ts",
    "./general-lobby": "./src/generalLobby.ts",
    "./games": "./src/games.ts",
    "./room-sharing": "./src/roomSharing.ts",
    "./match-sharing": "./src/matchSharing.ts",
    "./replay-positions": "./src/replayPositions.ts",
    "./tournament-pages": "./src/tournamentPages.ts",
    "./privacy": "./src/privacy.ts",
    "./visits": "./src/visits.ts",
    "./visit-schema": "./src/visitSchema.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test ./test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.2"
  }
