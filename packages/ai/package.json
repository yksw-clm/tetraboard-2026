{
  "name": "@tetraboard/ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun run cf-typegen && bun check --no-script --all && tsc --noEmit -p cloudflare/tsconfig.json && bun run format:check && bun run lint",
    "typecheck:tsc": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json",
    "cf-typegen": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts",
    "deploy:cloud:dry-run": "wrangler deploy --config cloudflare/wrangler.jsonc --dry-run",
    "deploy:cloud": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "deploy:cloud:development": "wrangler deploy --config cloudflare/wrangler.jsonc --env development",
    "deploy:cloud:dry-run:development": "wrangler deploy --config cloudflare/wrangler.jsonc --env development --dry-run",
    "measure:cloud": "bun scripts/measureCloud.ts",
    "test": "cargo test --workspace --locked && cargo build --release --locked -p tetraboard-ai-server && bun test ./test",
    "bench": "cargo run --release --locked -p tetraboard-ai-benchmark --",
    "serve": "cargo run --release --locked -p tetraboard-ai-server",
    "check": "bun run typecheck && bun run test",
    "study:build": "cargo build --release --locked --bins",
    "study:tune": "bun run study:build && bun scripts/phase3Study.ts",
    "study:evaluate": "bun run study:build && bun scripts/phase3Evaluate.ts",
    "study:performance": "bun run study:build && bun scripts/phase3Performance.ts",
    "study:analyze": "cargo run --release --locked -p tetraboard-ai-benchmark --bin study -- analyze",
    "study:reversi-calibration": "bun scripts/reversiCalibration.ts",
    "study:lv6:preliminary": "cargo build --release --locked -p tetraboard-ai-benchmark && bun scripts/lv6Preliminary.ts",
    "serve:local": "bun scripts/serveLocal.ts",
    "setup:local": "bun scripts/setupLocal.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.5.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "openskill": "5.0.1"
  }
}
