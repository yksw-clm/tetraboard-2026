{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tetraboard-ai-validation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 },
  "containers": [
    {
      "class_name": "AiContainer",
      "image": "../Dockerfile.four-reversi",
      "image_build_context": "..",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "AI_CONTAINER", "class_name": "AiContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiContainer"] }],
  "env": {
    "development": {
      "name": "tetraboard-ai-dev",
      "vars": { "AI_SHOGI_ENABLED": "true" },
      "containers": [
        {
          "class_name": "AiContainer",
          "image": "../Dockerfile.four-reversi",
          "image_build_context": "..",
          "instance_type": "basic",
          "max_instances": 1,
        },
        {
          "class_name": "ShogiContainer",
          "image": "../Dockerfile",
          "image_build_context": "..",
          "instance_type": "basic",
          "max_instances": 1,
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "AI_CONTAINER", "class_name": "AiContainer" },
          { "name": "SHOGI_CONTAINER", "class_name": "ShogiContainer" },
        ],
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["AiContainer"] },
        { "tag": "v2", "new_sqlite_classes": ["ShogiContainer"] },
      ],
    },
  },
}
