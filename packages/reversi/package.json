{
  "name": "@tetraboard/reversi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
