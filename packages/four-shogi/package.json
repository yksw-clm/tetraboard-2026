{
  "name": "@tetraboard/four-shogi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis.ts",
    "./ai": "./src/ai.ts",
    "./replay": "./src/replay.ts",
    "./action-encoding": "./src/actionEncoding.ts",
    "./model-features": "./src/modelFeatures.ts",
    "./model-inference": "./src/modelInference.ts",
    "./formation-catalog": "./src/formationCatalog.ts"
  },
  "scripts": {
    "bench": "bun bench/cli.ts",
    "bench:singles": "bun bench/singlesCli.ts",
    "bench:analysis": "bun bench/analysisCli.ts",
    "bench:search": "bun bench/searchExperimentCli.ts",
    "selfplay": "bun bench/selfPlayCli.ts",
    "training:export": "bun bench/trainingExport.ts",
    "training:smoke-data": "bun bench/trainingSmokeData.ts",
    "inference:fixture": "bun bench/inferenceFixture.ts",
    "inference:smoke": "bun bench/inferenceCli.ts",
    "bench:model": "bun bench/modelSearchCli.ts",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun ../../scripts/checkBunVersion.ts && bun check --no-script --all",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.5.2"
  }
}
