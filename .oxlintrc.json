{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "rules": {
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["apps/worker/src/**/*.ts", "packages/contexts/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": false,
            "skipComments": false
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 60,
            "skipBlankLines": false,
            "skipComments": false,
            "IIFEs": true
          }
        ]
      }
    },
    {
      "files": ["apps/worker/test/**", "packages/contexts/**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 500,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": [
        "apps/worker/src/rooms/aiService.ts",
        "apps/worker/src/rooms/roomIndex.ts",
        "apps/worker/src/rooms/roomRoutes.ts",
        "apps/worker/test/accountRooms.test.ts",
        "apps/worker/test/feedback.test.ts",
        "apps/worker/test/fourShogiRoom.test.ts",
        "apps/worker/test/gameRoom.test.ts",
        "apps/worker/test/guestAccounts.test.ts",
        "apps/worker/test/guestRegistrationRooms.test.ts",
        "apps/worker/test/lobbyRoomCards.test.ts",
        "apps/worker/test/matchmaking.test.ts",
        "apps/worker/test/privacy.test.ts",
        "apps/worker/test/registrationApi.test.ts",
        "apps/worker/test/roomDeadlineBoundary.test.ts",
        "apps/worker/test/tournamentQueue.test.ts",
        "apps/worker/test/tournamentRooms.test.ts",
        "apps/worker/test/tournaments.test.ts"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": [
        "apps/worker/src/rooms/aiService.ts",
        "apps/worker/src/rooms/applyRoomSettings.ts",
        "apps/worker/src/rooms/rankingRoutes.ts",
        "apps/worker/src/rooms/roomIndex.ts",
        "apps/worker/src/rooms/roomRoutes.ts"
      ],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
