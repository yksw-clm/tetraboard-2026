{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "rules": {
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": ["apps/worker/src/**/*.ts", "packages/contexts/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 300,
            "skipBlankLines": false,
            "skipComments": false
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 60,
            "skipBlankLines": false,
            "skipComments": false,
            "IIFEs": true
          }
        ]
      }
    },
    {
      "files": ["apps/worker/test/**", "packages/contexts/**/*.test.ts"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 500,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
